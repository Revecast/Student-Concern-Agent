reach section.</description><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Output.Prompt</assignToReference><operator>Add</operator><value><elementReference>textT_OutreachHeader</elementReference></value></assignmentItems><connector><targetReference>Is_There_Outreach</targetReference></connector></assignments><assignments><name>Add_No_Outreach</name><label>Add No Outreach</label><description>Nothing sent yet.</description><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Output.Prompt</assignToReference><operator>Add</operator><value><elementReference>textT_NoOutreach</elementReference></value></assignmentItems></assignments><assignments><name>Add_Outreach_Line</name><label>Add Outreach Line</label><description>Adds the outreach line.</description><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>$Output.Prompt</assignToReference><operator>Add</operator><value><elementReference>textT_OutreachLine</elementReference></value></assignmentItems><assignmentItems><assignToReference>varN_OutreachCount</assignToReference><operator>Add</operator><value><numberValue>1</numberValue></value></assignmentItems><connector><targetReference>Loop_Through_Outreach</targetReference></connector></assignments><decisions><name>Is_There_Classroom_Activity</name><label>Is There Classroom Activity?</label><description>Empty list writes Not available.</description><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Add_No_Activity</targetReference></defaultConnector><defaultConnectorLabel>No</defaultConnectorLabel><rules><name>Has_Activity</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Classroom_Activity</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Loop_Through_Classroom_Activities</targetReference></connector><label>Has Activity</label></rules></decisions><decisions><name>Is_There_Outreach</name><label>Is There Outreach?</label><description>Empty list writes None yet.</description><locationX>0</locationX><locationY>0</locationY><defaultConnector><targetReference>Add_No_Outreach</targetReference></defaultConnector><defaultConnectorLabel>No</defaultConnectorLabel><rules><name>Has_Outreach</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Get_Outreach</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Loop_Through_Outreach</targetReference></connector><label>Has Outreach</label></rules></decisions><decisions><name>Under_Ten_Rows</name><label>Under Ten Rows?</label><description>Keeps the prompt short: at most 10 outreach rows.</description><locationX>0</locationX><locationY>0</locationY><defaultConnectorLabel>Enough</defaultConnectorLabel><rules><name>Room_for_More</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>varN_OutreachCount</leftValueReference><operator>LessThan</operator><rightValue><numberValue>10</numberValue></rightValue></conditions><connector><targetReference>Add_Outreach_Line</targetReference></connector><label>Room for More</label></rules></decisions><description>Grounding for the Student Risk Summary prompt template (SCA-17). Reads the student's classroom activity (grades and last login per course) and their 10 most recent outreach log rows, and adds them to the prompt as plain lines. Writes "Not available" or "None yet" when there is nothing, so the model never has to guess. No attendance read: missed classes are already stated in the risk reason (SCA-11). Update Message: v3 adds score, flagged and reason with Not available when blank; items marked with bullets since Flow trims line breaks (SCA-17). v2: runs only for users granted Flow Access (isAdditionalPermissionRequiredToRun), so the permission set grant applies without Run Flows (SCA-36 QA fix).</description><environments>Default</environments><formulas><name>forT_RiskLines</name><dataType>String</dataType><description>Score, flagged yes/no and reason, with Not available when blank, so the model never fills a gap.</description><expression>"Risk score: " &amp; IF(ISBLANK({!Student.Risk_Score__c}), "Not available", TEXT({!Student.Risk_Score__c})) &amp; " (the advisor is alerted at 6 or more). Flagged: " &amp; IF(AND(NOT(ISBLANK({!Student.Risk_Score__c})), {!Student.Risk_Score__c} &gt;= 6), "yes", "no") &amp; ". Risk reason: " &amp; BLANKVALUE({!Student.Risk_Reason__c}, "Not available") &amp; ". "</expression></formulas><interviewLabel>PF – Student Risk Grounding {!$Flow.CurrentDateTime}</interviewLabel><isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun><label>PF – Student Risk Grounding</label><loops><name>Loop_Through_Classroom_Activities</name><label>Loop Through Classroom Activities</label><description>One line per course.</description><locationX>0</locationX><locationY>0</locationY><collectionReference>Get_Classroom_Activity</collectionReference><iterationOrder>Asc</iterationOrder><nextValueConnector><targetReference>Add_Activity_Line</targetReference></nextValueConnector><noMoreValuesConnector><targetReference>Get_Outreach</targetReference></noMoreValuesConnector></loops><loops><name>Loop_Through_Outreach</name><label>Loop Through Outreach</label><description>Newest outreach rows.</description><locationX>0</locationX><locationY>0</locationY><collectionReference>Get_Outreach</collectionReference><iterationOrder>Asc</iterationOrder><nextValueConnector><targetReference>Under_Ten_Rows</targetReference></nextValueConnector></loops><processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues><processType>PromptFlow</processType><recordLookups><name>Get_Classroom_Activity</name><label>Get Classroom Activities</label><description>Grades and last login per course (simulated classroom system, ADR-004).</description><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Add_Activity_Header</targetReference></connector><filterLogic>and</filterLogic><filters><field>Student__c</field><operator>EqualTo</operator><value><elementReference>Student.Id</elementReference></value></filters><getFirstRecordOnly>false</getFirstRecordOnly><object>Classroom_Activity__c</object><sortField>Course_Name__c</sortField><sortOrder>Asc</sortOrder><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups><recordLookups><name>Get_Outreach</name><label>Get Outreach</label><description>The student's outreach log, newest first.</description><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Add_Outreach_Header</targetReference></connector><filterLogic>and</filterLogic><filters><field>Student__c</field><operator>EqualTo</operator><value><elementReference>Student.Id</elementReference></value></filters><getFirstRecordOnly>false</getFirstRecordOnly><object>Student_Outreach__c</object><sortField>Sent_At__c</sortField><sortOrder>Desc</sortOrder><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups><start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Add_Risk_Lines</targetReference></connector><triggerType>Capability</triggerType></start><status>Active</status><textTemplates><name>textT_ActivityLine</name><description>One line per course.</description><isViewedAsPlainText>true</isViewedAsPlainText><text>• {!Loop_Through_Classroom_Activities.Course_Name__c}: current grade {!Loop_Through_Classroom_Activities.Current_Grade__c}, two weeks ago {!Loop_Through_Classroom_Activities.Grade_Two_Weeks_Ago__c}, last classroom login {!Loop_Through_Classroom_Activities.Last_Login__c}. </text></textTemplates><textTemplates><name>textT_OutreachLine</name><description>One line per outreach row.</description><isViewedAsPlainText>true</isViewedAsPlainText><text>• {!Loop_Through_Outreach.Sent_At__c}: {!Loop_Through_Outreach.Channel__c} to {!Loop_Through_Outreach.Recipient_Type__c}, status {!Loop_Through_Outreach.Status__c}, student replied: {!Loop_Through_Outreach.Student_Replied__c}. </text></textTemplates><textTemplates><name>textT_ActivityHeader</name><description>Section heading.</description><isViewedAsPlainText>true</isViewedAsPlainText><text>Classroom activity by course: </text></textTemplates><textTemplates><name>textT_OutreachHeader</name><description>Section heading.</description><isViewedAsPlainText>true</isViewedAsPlainText><text>Recent outreach, newest first: </text></textTemplates><textTemplates><name>textT_NoActivity</name><description>No classroom activity rows.</description><isViewedAsPlainText>true</isViewedAsPlainText><text>• Not available. </text></textTemplates><textTemplates><name>textT_NoOutreach</name><description>No outreach rows.</description><isViewedAsPlainText>true</isViewedAsPlainText><text>• None yet. </text></textTemplates><variables><name>Student</name><dataType>SObject</dataType><description>The student (Contact) the summary is about. Passed in by the prompt template.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><objectType>Contact</objectType></variables><variables><name>varN_OutreachCount</name><dataType>Number</dataType><description>Outreach rows added so far (stops at 10).</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>0</scale><value><numberValue>0</numberValue></value></variables></Flow>
